---
import Base from '../layouts/Base.astro';
import { path } from '../i18n/ui';
---
<Base title="Η σελίδα δεν βρέθηκε · Θεοδοσίου Τεχνική Α.Ε." lang="el" noindex>
  <section class="nf wrap" data-hero>
    <div class="nf__text">
      <p class="eyebrow t-label" data-reveal><span class="eyebrow__num">404</span><span class="eyebrow__rule"></span>Page not found</p>
      <h1 class="t-h1" data-lines>
        <span class="mask"><span>Λείπει</span></span>
        <span class="mask"><span>ένας όροφος.</span></span>
      </h1>
      <p class="t-lead" data-reveal style="--i:6">Η σελίδα που ζητήσατε δεν υπάρχει ή έχει μετακινηθεί.</p>
      <div class="nf__links" data-reveal style="--i:8">
        <a class="btn" href={path('home', 'el')}>Αρχική <span class="btn__arrow" aria-hidden="true">→</span></a>
        <a class="link" href={path('buildings', 'el')}>Τα κτίρια</a>
      </div>
    </div>
    <svg class="nf__art" viewBox="0 0 220 320" fill="none" stroke="currentColor" aria-hidden="true" data-draw>
      <path class="d" pathLength="1" stroke-width="1.25" d="M0 300H220" style="--d:0" />
      <path class="d" pathLength="1" stroke-width="1.25" d="M40 300V180H180V300" style="--d:200" />
      <path class="d faint" pathLength="1" stroke-width="0.75" d="M40 240H180" style="--d:600" />
      <path class="f" stroke-width="1" stroke-dasharray="4 6" d="M40 180V120H180V180" style="--d:900" />
      <path class="d" pathLength="1" stroke-width="1.25" d="M40 120V60H180V120" style="--d:1200" />
      <path class="d faint" pathLength="1" stroke-width="0.75" d="M40 90H180" style="--d:1500" />
    </svg>
  </section>
</Base>

<style>
  .nf {
    min-height: 100svh; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter);
    align-items: center; padding-top: var(--header-h); padding-bottom: var(--s-9);
  }
  .nf__text { grid-column: 1 / span 6; display: grid; gap: var(--s-6); justify-items: start; }
  .nf__links { display: flex; align-items: center; gap: var(--s-6); flex-wrap: wrap; }
  .nf__art { grid-column: 8 / span 4; width: 100%; max-height: 60vh; }
  .faint { opacity: 0.4; }
  @media (max-width: 960px) {
    .nf__text { grid-column: 1 / -1; }
    .nf__art { grid-column: 1 / -1; grid-row: 1; max-height: 220px; margin-top: var(--s-9); }
  }
</style>
