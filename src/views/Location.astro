---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import AreaMap from '../components/AreaMap.astro';
import { COMPANY } from '../lib/buildings';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;

// [COORDINATES] Approximate centre of Chalandri until the client confirms each building.
const lat = 38.0213;
const lon = 23.7987;
const d = 0.006;
const osmEmbed = `https://www.openstreetmap.org/export/embed.html?bbox=${lon - d}%2C${lat - d / 2}%2C${lon + d}%2C${lat + d / 2}&layer=mapnik&marker=${lat}%2C${lon}`;
const googleMaps = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent('Χαλάνδρι, Ελλάδα')}`;

const copy = {
  el: {
    title: 'Τοποθεσία · Θεοδοσίου Τεχνική Α.Ε.',
    description: 'Τα κτίρια της Θεοδοσίου Τεχνική Α.Ε. βρίσκονται στο Χαλάνδρι. Διεύθυνση, χάρτης και πρόσβαση.',
    eyebrow: 'Τοποθεσία',
    lines: ['Στην καρδιά', 'του Χαλανδρίου.'],
    mapTitle: 'Περιοχή και χάρτης',
    addressLabel: 'Περιοχή',
    openMaps: 'Το Χαλάνδρι στο Google Maps',
    loadMap: 'Εμφάνιση χάρτη',
    mapHint: 'Ο χάρτης φορτώνει από το OpenStreetMap μόνο όταν τον ζητήσετε.',
    iframeTitle: 'Χάρτης: Χαλάνδρι',
    mapLabel: 'Χαλάνδρι',
    accessEyebrow: 'Πρόσβαση',
    accessTitle: 'Εύκολα προσβάσιμα.',
    access: [
      { label: 'Μετρό', text: '[Σταθμός και απόσταση, π.χ. «Χαλάνδρι», 8′ με τα πόδια]' },
      { label: 'Λεωφορεία', text: '[Γραμμές και στάσεις]' },
      { label: 'Οδικώς', text: '[Κεντρικοί δρόμοι, π.χ. Λ. Κηφισίας, Αττική Οδός]' },
      { label: 'Στάθμευση', text: '[Θέσεις στάθμευσης ή κοντινά πάρκινγκ]' },
    ],
  },
  en: {
    title: 'Location · Theodosiou Texniki AE',
    description: 'The buildings of Theodosiou Texniki AE are in Chalandri, Athens. Address, map and access.',
    eyebrow: 'Location',
    lines: ['In the heart', 'of Chalandri.'],
    mapTitle: 'Area and map',
    addressLabel: 'Area',
    openMaps: 'Chalandri on Google Maps',
    loadMap: 'Show map',
    mapHint: 'The map loads from OpenStreetMap only when you ask for it.',
    iframeTitle: 'Map: Chalandri',
    mapLabel: 'Chalandri',
    accessEyebrow: 'Access',
    accessTitle: 'Easy to reach.',
    access: [
      { label: 'Metro', text: '[Station and distance, e.g. "Chalandri", 8 min walk]' },
      { label: 'Buses', text: '[Lines and stops]' },
      { label: 'By car', text: '[Main roads, e.g. Kifisias Ave., Attiki Odos]' },
      { label: 'Parking', text: '[Parking spaces or nearby car parks]' },
    ],
  },
}[lang];
---
<Base title={copy.title} description={copy.description} lang={lang} page="location">
  <PageIntro eyebrow={copy.eyebrow} lines={copy.lines} />

  <section class="section location" aria-labelledby="map-title">
    <div class="wrap grid">
      <div class="loc__text">
        <h2 class="visually-hidden" id="map-title">{copy.mapTitle}</h2>
        <p class="t-label muted" data-reveal>{copy.addressLabel}</p>
        <p class="t-h3" data-reveal>{COMPANY.area[lang]}<br />{COMPANY.seat[lang]}</p>
        <div class="loc__links" data-reveal>
          <a class="text-cta" href={googleMaps} target="_blank" rel="noopener">{copy.openMaps} <span class="btn__arrow" aria-hidden="true">↗</span></a>
        </div>
      </div>

      <div class="loc__map" data-map>
        <div class="loc__placeholder" data-map-placeholder>
          <AreaMap label={copy.mapLabel} />
          <button class="btn loc__load" type="button" data-map-load>{copy.loadMap}</button>
          <p class="t-small muted loc__hint">{copy.mapHint}</p>
        </div>
        <template data-map-template>
          <iframe class="loc__iframe" title={copy.iframeTitle} src={osmEmbed} loading="lazy" referrerpolicy="no-referrer"></iframe>
        </template>
      </div>
    </div>
  </section>

  <section class="section section--stone" aria-labelledby="access-title">
    <div class="wrap grid">
      <div class="access__head">
        <p class="eyebrow t-label" data-reveal><span class="eyebrow__num">01</span><span class="eyebrow__rule"></span>{copy.accessEyebrow}</p>
        <h2 class="t-h2" id="access-title" data-reveal>{copy.accessTitle}</h2>
      </div>
      <dl class="access" data-reveal-group>
        {copy.access.map((a) => (
          <div data-reveal>
            <dt class="t-label">{a.label}</dt>
            <dd class="t-body muted">{a.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>

<script>
  document.addEventListener('astro:page-load', () => {
    const wrap = document.querySelector<HTMLElement>('[data-map]');
    const btn = wrap?.querySelector<HTMLButtonElement>('[data-map-load]');
    const tpl = wrap?.querySelector<HTMLTemplateElement>('[data-map-template]');
    btn?.addEventListener('click', () => {
      if (!wrap || !tpl) return;
      wrap.querySelector('[data-map-placeholder]')?.remove();
      wrap.append(tpl.content.cloneNode(true));
    });
  });
</script>

<style>
  .location .grid { row-gap: var(--s-8); align-items: start; }
  .loc__text { grid-column: 1 / span 4; display: grid; gap: var(--s-5); justify-items: start; }
  .loc__links { display: grid; gap: var(--s-4); margin-top: var(--s-4); }
  .loc__map { grid-column: 6 / -1; position: relative; aspect-ratio: 4 / 3; background: var(--stone); }
  .loc__placeholder { position: absolute; inset: 0; display: grid; place-items: center; padding: var(--s-6); }
  .loc__placeholder :global(.area-map) { position: absolute; inset: var(--s-6); width: calc(100% - 2 * var(--s-6)); height: calc(100% - 2 * var(--s-6)); color: var(--ink); opacity: 0.5; }
  .loc__load { position: relative; }
  .loc__hint { position: absolute; bottom: var(--s-4); left: var(--s-6); right: var(--s-6); text-align: center; }
  .loc__iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; filter: grayscale(1) contrast(0.95) sepia(0.12); }

  .access__head { grid-column: 1 / span 5; display: grid; gap: var(--s-5); align-content: start; }
  .access { grid-column: 7 / -1; }
  .access > div { display: grid; grid-template-columns: 140px 1fr; gap: var(--s-5); padding-block: var(--s-5); border-bottom: 1px solid var(--hairline); }
  .access > div:first-child { border-top: 1px solid var(--ink); }

  @media (max-width: 960px) {
    .loc__text, .loc__map, .access__head, .access { grid-column: 1 / -1; }
    .access__head { margin-bottom: var(--s-7); }
  }
  @media (max-width: 600px) {
    .access > div { grid-template-columns: 1fr; gap: var(--s-2); }
    .loc__map { aspect-ratio: 1; }
  }
</style>
