---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { COMPANY } from '../lib/buildings';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;

// Draft for the client's legal review. Not legal advice.
const copy = {
  el: {
    title: 'Πολιτική Απορρήτου · Θεοδοσίου Τεχνική Α.Ε.',
    eyebrow: 'Πολιτική Απορρήτου',
    lines: ['Τα στοιχεία σας,', 'με προσοχή.'],
    lead: 'Τελευταία ενημέρωση: [ΗΜΕΡΟΜΗΝΙΑ]',
    sections: [
      { h: 'Υπεύθυνος επεξεργασίας', p: `ΘΕΟΔΟΣΙΟΥ ΤΕΧΝΙΚΗ Α.Ε., ${COMPANY.address.el}, ${COMPANY.postcode.el}. ΓΕΜΗ [—], ΑΦΜ [—]. Email: ${COMPANY.email}, τηλ. ${COMPANY.phone}.` },
      { h: 'Ποια δεδομένα συλλέγουμε', p: 'Η φόρμα επικοινωνίας δεν αποθηκεύει και δεν στέλνει δεδομένα σε κανέναν διακομιστή. Απλώς ετοιμάζει ένα email στη δική σας εφαρμογή email, το οποίο στέλνετε εσείς. Λαμβάνουμε μόνο όσα περιέχει αυτό το email: ονοματεπώνυμο, εταιρεία, email, τηλέφωνο, το κτίριο που σας ενδιαφέρει και το μήνυμά σας. Η παροχή τους δεν είναι υποχρεωτική, αλλά χωρίς αυτά δεν μπορούμε να σας απαντήσουμε.' },
      { h: 'Γιατί τα χρησιμοποιούμε', p: 'Για να απαντήσουμε στο αίτημά σας και, αν το ζητήσετε, να σας ενημερώσουμε όταν κάποιο κτίριο διατεθεί. Νομική βάση είναι η απάντηση σε δικό σας αίτημα πριν από τη σύναψη σύμβασης (άρθρο 6 παρ. 1β ΓΚΠΔ). Δεν λαμβάνουμε αυτοματοποιημένες αποφάσεις και δεν δημιουργούμε προφίλ.' },
      { h: 'Πόσο καιρό τα κρατάμε', p: '[ΔΙΑΣΤΗΜΑ, π.χ. έως 24 μήνες] ή μέχρι να ζητήσετε τη διαγραφή τους.' },
      { h: 'Ποιος έχει πρόσβαση', p: 'Τα μηνύματά σας φτάνουν μόνο στο email της εταιρείας, το οποίο φιλοξενείται από [ΠΑΡΟΧΟΣ EMAIL]. Δεν πωλούμε ούτε μοιραζόμαστε τα στοιχεία σας για διαφημιστικούς σκοπούς.' },
      { h: 'Φιλοξενία του ιστότοπου', p: 'Ο ιστότοπος φιλοξενείται στο GitHub Pages της GitHub, Inc. (ΗΠΑ). Όπως κάθε διακομιστής, καταγράφει τεχνικά στοιχεία, όπως τη διεύθυνση IP σας, για την ασφαλή λειτουργία της υπηρεσίας, βάσει έννομου συμφέροντος (άρθρο 6 παρ. 1στ ΓΚΠΔ). Εμείς δεν έχουμε πρόσβαση σε αυτά. Η διαβίβαση στις ΗΠΑ στηρίζεται στο Πλαίσιο Προστασίας Δεδομένων ΕΕ–ΗΠΑ. [ΝΑ ΕΠΙΒΕΒΑΙΩΘΕΙ]' },
      { h: 'Χάρτης και εξωτερικοί σύνδεσμοι', p: 'Ο χάρτης φορτώνει από το OpenStreetMap (OpenStreetMap Foundation, Ηνωμένο Βασίλειο) μόνο αν πατήσετε «Εμφάνιση χάρτη». Τότε ο φυλλομετρητής σας στέλνει τη διεύθυνση IP σας στο OpenStreetMap. Οι σύνδεσμοι προς το Google Maps ανοίγουν σελίδες της Google, όπου ισχύει η δική της πολιτική απορρήτου.' },
      { h: 'Cookies', p: 'Ο ιστότοπος δεν χρησιμοποιεί cookies ούτε άλλα μέσα αποθήκευσης στη συσκευή σας, και δεν χρησιμοποιεί εργαλεία στατιστικών ή διαφήμισης. Γι’ αυτό δεν εμφανίζεται μήνυμα συγκατάθεσης για cookies.' },
      { h: 'Τα δικαιώματά σας', p: 'Έχετε δικαίωμα πρόσβασης, διόρθωσης, διαγραφής, περιορισμού και φορητότητας των δεδομένων σας, καθώς και εναντίωσης στην επεξεργασία. Γράψτε μας στο email παραπάνω και θα απαντήσουμε εντός ενός μήνα. Μπορείτε επίσης να υποβάλετε καταγγελία στην Αρχή Προστασίας Δεδομένων Προσωπικού Χαρακτήρα, Λεωφ. Κηφισίας 1-3, 115 23 Αθήνα (www.dpa.gr).' },
      { h: 'Αλλαγές', p: 'Αν αλλάξει αυτή η πολιτική, η νέα έκδοση δημοσιεύεται σε αυτή τη σελίδα με νέα ημερομηνία ενημέρωσης.' },
    ],
  },
  en: {
    title: 'Privacy Policy · Theodosiou Texniki AE',
    eyebrow: 'Privacy Policy',
    lines: ['Your details,', 'handled with care.'],
    lead: 'Last updated: [DATE]',
    sections: [
      { h: 'Data controller', p: `THEODOSIOU TEXNIKI AE, ${COMPANY.address.en}, ${COMPANY.postcode.en}. GEMI [—], VAT [—]. Email: ${COMPANY.email}, tel. ${COMPANY.phone}.` },
      { h: 'What data we collect', p: 'The contact form does not store or send data to any server. It simply prepares an email in your own email app, which you send yourself. We only receive what that email contains: full name, company, email, phone, the building you are interested in and your message. Providing these details is optional, but without them we cannot reply.' },
      { h: 'Why we use it', p: 'To reply to your request and, if you ask us to, to let you know when a building becomes available. The legal basis is replying to your own request before entering into a contract (Article 6(1)(b) GDPR). We make no automated decisions and do no profiling.' },
      { h: 'How long we keep it', p: '[PERIOD, e.g. up to 24 months] or until you ask us to delete it.' },
      { h: 'Who has access', p: "Your messages reach only the company's email inbox, which is hosted by [EMAIL PROVIDER]. We do not sell or share your details for advertising purposes." },
      { h: 'Website hosting', p: 'The website is hosted on GitHub Pages by GitHub, Inc. (USA). Like any web server, it logs technical data such as your IP address to run the service securely, based on legitimate interest (Article 6(1)(f) GDPR). We have no access to this data. Transfers to the USA rely on the EU–US Data Privacy Framework. [TO CONFIRM]' },
      { h: 'Map and external links', p: 'The map loads from OpenStreetMap (OpenStreetMap Foundation, United Kingdom) only if you click "Show map". Your browser then sends your IP address to OpenStreetMap. Links to Google Maps open Google pages, where Google\'s own privacy policy applies.' },
      { h: 'Cookies', p: 'This website uses no cookies or any other storage on your device, and no analytics or advertising tools. That is why no cookie consent banner is shown.' },
      { h: 'Your rights', p: 'You have the right to access, correct, delete, restrict and port your data, and to object to processing. Email us at the address above and we will reply within one month. You can also lodge a complaint with the Hellenic Data Protection Authority, 1-3 Kifisias Ave., 115 23 Athens (www.dpa.gr).' },
      { h: 'Changes', p: 'If this policy changes, the new version is published on this page with a new "last updated" date.' },
    ],
  },
}[lang];
---
<Base title={copy.title} lang={lang} page="privacy">
  <PageIntro eyebrow={copy.eyebrow} lines={copy.lines} lead={copy.lead} />
  <section class="section">
    <div class="wrap grid">
      <div class="policy">
        {copy.sections.map((s, i) => (
          <section class="policy__item">
            <h2 class="t-h3"><span class="policy__num t-label num">{String(i + 1).padStart(2, '0')}</span>{s.h}</h2>
            <p class="t-body muted">{s.p}</p>
          </section>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .policy { grid-column: 3 / span 8; display: grid; }
  .policy__item { display: grid; gap: var(--s-4); padding-block: var(--s-7); border-bottom: 1px solid var(--hairline); }
  .policy__item:first-child { border-top: 1px solid var(--ink); }
  .policy__item h2 { display: flex; align-items: baseline; gap: var(--s-5); }
  .policy__num { color: var(--accent-text); }
  @media (max-width: 960px) { .policy { grid-column: 1 / -1; } }
</style>
