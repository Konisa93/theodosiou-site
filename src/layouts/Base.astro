---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/noto-serif-display/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';

import { routes, type Lang, type RouteKey } from '../i18n/ui';
import { buildSchema } from '../lib/schema';
import { PRELAUNCH } from '../../site.config.mjs';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  page?: RouteKey; // enables the language switcher target, hreflang tags and structured data
  noindex?: boolean;
  chrome?: boolean; // site footer + mobile CTA bar
}
const { title, description = '', lang = 'el', page, noindex = false, chrome = true } = Astro.props;
const site = Astro.site!;
const abs = (p: string) => new URL(p, site).href;
const alternates = page ? routes[page] : null;
const robots = PRELAUNCH || noindex ? 'noindex, nofollow' : 'index, follow';
const ogImage = abs(`/og/og-${lang}.png`);
const siteName = lang === 'el' ? 'Θεοδοσίου Τεχνική Α.Ε.' : 'Theodosiou Texniki AE';
const schema = page ? JSON.stringify(buildSchema({ lang, page, site })) : null;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content={robots} />
    {alternates && (
      <>
        <link rel="canonical" href={abs(alternates[lang])} />
        <link rel="alternate" hreflang="el" href={abs(alternates.el)} />
        <link rel="alternate" hreflang="en" href={abs(alternates.en)} />
        <link rel="alternate" hreflang="x-default" href={abs(alternates.el)} />
      </>
    )}

    <!-- Share previews -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {alternates && <meta property="og:url" content={abs(alternates[lang])} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteName} />
    <meta property="og:locale" content={lang === 'el' ? 'el_GR' : 'en_GB'} />
    <meta property="og:locale:alternate" content={lang === 'el' ? 'en_GB' : 'el_GR'} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#F5F2EC" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {schema && <script type="application/ld+json" set:html={schema} />}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'el' ? 'Μετάβαση στο περιεχόμενο' : 'Skip to content'}</a>
    <Header lang={lang} page={page} />
    <main id="main">
      <slot />
    </main>
    {chrome && <Footer lang={lang} />}
    {chrome && <StickyCta lang={lang} />}
    <script>
      import { initMotion } from '../scripts/motion.js';
      document.addEventListener('astro:page-load', () => initMotion());
    </script>
  </body>
</html>
